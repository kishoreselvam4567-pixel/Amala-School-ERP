rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isAdminEmail() {
      return signedIn() && (
        request.auth.token.email == 'amala@123.gmail.com' ||
        request.auth.token.email == 'admin@kishore.gmail.com' ||
        request.auth.token.email == 'amala123@gmail.com'
      );
    }

    function hasUserDoc() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myRole() {
      return hasUserDoc() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : '';
    }

    function isAdmin() { return isAdminEmail() || (signedIn() && myRole() == 'admin'); }
    function isStaff() { return signedIn() && myRole() == 'staff'; }
    function isAdminOrStaff() { return isAdmin() || isStaff(); }

    // loginLookup: safe pre-auth resolution — only { email } field, no PII
    // Unauthenticated clients may GET by document ID only (no list).
    match /loginLookup/{lookupId} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    // users: requires auth; users read own doc, admin reads all
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // students: own-record get for students; list only for admin/staff
    match /students/{studentUid} {
      allow get:    if signedIn() && (request.auth.uid == studentUid || isAdminOrStaff());
      allow list:   if isAdminOrStaff();
      allow create: if signedIn() && (request.auth.uid == studentUid || isAdmin());
      allow update: if isAdminOrStaff() || (signedIn() && request.auth.uid == studentUid);
      allow delete: if isAdmin();
    }

    // staff: own-record get; admin lists and writes
    match /staff/{staffUid} {
      allow get:    if signedIn() && (request.auth.uid == staffUid || isAdmin());
      allow list:   if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // parents: own-record get; admin lists and writes
    match /parents/{parentUid} {
      allow get:    if signedIn() && (request.auth.uid == parentUid || isAdmin());
      allow list:   if isAdmin();
      allow create: if signedIn() && (request.auth.uid == parentUid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /attendance/{docId}    { allow read: if signedIn(); allow write: if isAdminOrStaff(); }
    match /marks/{docId}         { allow read: if signedIn(); allow write: if isAdminOrStaff(); }
    match /exams/{docId}         { allow read: if signedIn(); allow write: if isAdminOrStaff(); }
    match /notes/{docId}         { allow read: if signedIn(); allow write: if isAdminOrStaff(); }
    match /homework/{docId}      { allow read: if signedIn(); allow write: if isAdminOrStaff(); }
    match /announcements/{docId} { allow read: if signedIn(); allow write: if isAdmin(); }
  }
}
