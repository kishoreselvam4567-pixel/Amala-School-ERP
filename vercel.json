{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/login", "destination": "/login.html" },
    { "source": "/register", "destination": "/register.html" },
    { "source": "/admin", "destination": "/internal/admin/dashboard.html" },
    { "source": "/staff", "destination": "/internal/staff/dashboard.html" },
    { "source": "/student", "destination": "/student/dashboard.html" },
    { "source": "/parent", "destination": "/parent/dashboard.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
